# LiveKit Cloud project (https://cloud.livekit.io -> Settings -> Keys)
# Server-side only. Never prefix these with NEXT_PUBLIC_.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Where the PartyKit game server lives.
# Local dev: localhost:1999   Production: mafia-table.<your-username>.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999
