{
  "name": "mafia-table",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:party": "partykit dev --var ALLOW_BOTS=true",
    "dev:all": "partykit dev --var ALLOW_BOTS=true & next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy:party": "partykit deploy"
  },
  "dependencies": {
    "framer-motion": "^14.14.0",
    "livekit-client": "^2.25.0",
    "livekit-server-sdk": "^2.20.1",
    "next": "^16.4.6",
    "partysocket": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "partykit": "^0.0.115",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
